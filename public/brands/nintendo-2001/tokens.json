{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens for Nintendo.com (2001) Analysis",
  "meta": {
    "name": "Nintendo.com (2001) Analysis",
    "description": "An analysis of Nintendo.com's 2001 design language — a brushed-periwinkle \"console chrome\" interface where every panel is a beveled metal plate, navigation glows amber over a halftone-dotted carbon bar, and bold outlined display type sits on circuit-board hero fields. A Y2K hardware aesthetic that treats the web page like the faceplate of a game system.",
    "theme": "light"
  },
  "color": {
    "primary": {
      "$value": "\"#e60012\"          # Nintendo Red — racetrack logo, alert",
      "$type": "color",
      "$description": "Use for the primary role."
    },
    "signal": {
      "$value": "#f68d1f\"           # Signal Orange — forward cues, submit, \"Play It On",
      "$type": "color",
      "$description": "Use for the signal role."
    },
    "amber": {
      "$value": "\"#ecab37\"            # Amber — utility buttons, info-box tabs, badges",
      "$type": "color",
      "$description": "Use for the amber role."
    },
    "nav-gold": {
      "$value": "\"#e48600\"         # Nav Gold — top-nav menu links",
      "$type": "color",
      "$description": "Use for the nav gold role."
    },
    "canvas": {
      "$value": "\"#7a8aba\"           # Periwinkle metallic — primary interface body",
      "$type": "color",
      "$description": "Use for the canvas role."
    },
    "canvas-soft": {
      "$value": "\"#9fbee7\"      # Pale Sky — secondary-nav strip, light inset panels",
      "$type": "color",
      "$description": "Use for the canvas soft role."
    },
    "sky": {
      "$value": "\"#9fbee7\"              # Pale Sky alias",
      "$type": "color",
      "$description": "Use for the sky role."
    },
    "lavender": {
      "$value": "\"#acace7\"         # Pale Lavender — home hero field",
      "$type": "color",
      "$description": "Use for the lavender role."
    },
    "ice": {
      "$value": "\"#c0d5e6\"              # Pale Ice — news hero field",
      "$type": "color",
      "$description": "Use for the ice role."
    },
    "periwinkle": {
      "$value": "\"#8ba1d4\"       # Light Periwinkle — raised mid panels",
      "$type": "color",
      "$description": "Use for the periwinkle role."
    },
    "chrome-indigo": {
      "$value": "\"#3d4f97\"    # Chrome Indigo — beveled borders, tab edges",
      "$type": "color",
      "$description": "Use for the chrome indigo role."
    },
    "muted-indigo": {
      "$value": "\"#60619c\"     # Muted Indigo — inactive tabs, secondary chrome",
      "$type": "color",
      "$description": "Use for the muted indigo role."
    },
    "platinum": {
      "$value": "\"#dedede\"         # Platinum Gray — list-row / inset content surface",
      "$type": "color",
      "$description": "Use for the platinum role."
    },
    "surface": {
      "$value": "\"#ffffff\"          # White — content cards, list-row highlight",
      "$type": "color",
      "$description": "Use for the surface role."
    },
    "carbon": {
      "$value": "\"#21242e\"           # Carbon Navy — nav bar, dark buttons, footer, ink",
      "$type": "color",
      "$description": "Use for the carbon role."
    },
    "hairline": {
      "$value": "\"#5a5f8c\"         # blended bevel divider",
      "$type": "color",
      "$description": "Use for the hairline role."
    },
    "ink": {
      "$value": "\"#21242e\"              # primary text on light",
      "$type": "color",
      "$description": "Use for the ink role."
    },
    "ink-soft": {
      "$value": "\"#3d4f97\"         # secondary text / chrome labels",
      "$type": "color",
      "$description": "Use for the ink soft role."
    },
    "on-primary": {
      "$value": "\"#ffffff\"       # text on dark/red/orange chrome",
      "$type": "color",
      "$description": "Use for the on primary role."
    },
    "systems-teal": {
      "$value": "\"#206479\"     # Systems hero circuit-board cyan",
      "$type": "color",
      "$description": "Use for the systems teal role."
    },
    "games-red": {
      "$value": "\"#a7282b\"        # Games F-1 racing hero",
      "$type": "color",
      "$description": "Use for the games red role."
    },
    "error": {
      "$value": "\"#e60012\"            # validation / destructive (shares brand red)",
      "$type": "color",
      "$description": "Use for the error role."
    }
  },
  "typography": {
    "nav-link": {
      "$value": {
        "fontFamily": "Arial",
        "fontSize": "13px",
        "fontWeight": 700,
        "lineHeight": 1,
        "letterSpacing": "0.5px"
      },
      "$type": "typography",
      "$description": "Typography style for nav link."
    },
    "ui-label": {
      "$value": {
        "fontFamily": "Arial",
        "fontSize": "11px",
        "fontWeight": 700,
        "lineHeight": 1.1,
