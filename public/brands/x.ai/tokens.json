{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens for xAI-Inspired",
  "meta": {
    "name": "xAI-Inspired",
    "description": "An inspired interpretation of xAI's design language — Elon Musk's frontier-AI company whose web surface is a strict near-black canvas broken only by white pill outlines, occasional warm sunset / dusk gradient accents, a custom geometric sans (Universal Sans) for display, and an uppercase tracked monospace caption face; the whole system reads as engineered-cosmic, unmarketed.",
    "theme": "dark"
  },
  "color": {
    "primary": {
      "$value": "#ffffff",
      "$type": "color",
      "$description": "Use for the primary role."
    },
    "on-primary": {
      "$value": "#0a0a0a",
      "$type": "color",
      "$description": "Use for the on primary role."
    },
    "ink": {
      "$value": "#ffffff",
      "$type": "color",
      "$description": "Use for the ink role."
    },
    "ink-hover": {
      "$value": "#fafaf7",
      "$type": "color",
      "$description": "Use for the ink hover role."
    },
    "body": {
      "$value": "#dadbdf",
      "$type": "color",
      "$description": "Use for the body role."
    },
    "body-mid": {
      "$value": "#7d8187",
      "$type": "color",
      "$description": "Use for the body mid role."
    },
    "mute": {
      "$value": "#7d8187",
      "$type": "color",
      "$description": "Use for the mute role."
    },
    "hairline": {
      "$value": "#212327",
      "$type": "color",
      "$description": "Use for the hairline role."
    },
    "canvas": {
      "$value": "#0a0a0a",
      "$type": "color",
      "$description": "Use for the canvas role."
    },
    "canvas-soft": {
      "$value": "#1a1c20",
      "$type": "color",
      "$description": "Use for the canvas soft role."
    },
    "canvas-card": {
      "$value": "#191919",
      "$type": "color",
      "$description": "Use for the canvas card role."
    },
    "canvas-mid": {
      "$value": "#363a3f",
      "$type": "color",
      "$description": "Use for the canvas mid role."
    },
    "accent-sunset": {
      "$value": "#ff7a17",
      "$type": "color",
      "$description": "Use for the accent sunset role."
    },
    "accent-sunset-soft": {
      "$value": "#ffc285",
      "$type": "color",
      "$description": "Use for the accent sunset soft role."
    },
    "accent-dusk": {
      "$value": "#7c3aed",
      "$type": "color",
      "$description": "Use for the accent dusk role."
    },
    "accent-twilight": {
      "$value": "#c4b5fd",
      "$type": "color",
      "$description": "Use for the accent twilight role."
    },
    "accent-breeze": {
      "$value": "#a0c3ec",
      "$type": "color",
      "$description": "Use for the accent breeze role."
    },
    "accent-midnight": {
      "$value": "#0d1726",
      "$type": "color",
      "$description": "Use for the accent midnight role."
    }
  },
  "typography": {
    "display-xl": {
      "$value": {
        "fontFamily": "universalSans, Inter, system-ui, -apple-system, sans-serif",
        "fontSize": "96px",
        "fontWeight": 400,
        "lineHeight": "96px",
        "letterSpacing": "-2.4px"
      },
      "$type": "typography",
      "$description": "Typography style for display xl."
    },
    "display-lg": {
      "$value": {
        "fontFamily": "universalSans, Inter, system-ui, sans-serif",
        "fontSize": "72px",
        "fontWeight": 400,
        "lineHeight": "72px",
        "letterSpacing": "-1.8px"
      },
      "$type": "typography",
      "$description": "Typography style for display lg."
    },
    "display-md": {
      "$value": {
        "fontFamily": "universalSans, Inter, system-ui, sans-serif",
        "fontSize": "48px",
        "fontWeight": 400,
        "lineHeight": "48px",
        "letterSpacing": "-1.2px"
      },
      "$type": "typography",
      "$description": "Typography style for display md."
    },
    "display-sm": {
      "$value": {
        "fontFamily": "universalSans, Inter, system-ui, sans-serif",
        "fontSize": "32px",
        "fontWeight": 400,
        "lineHeight": "36px",
        "letterSpacing": "-0.6px"
      },
      "$type": "typography",
      "$description": "Typography style for display sm."
    },
    "display-xs": {
      "$value": {
        "fontFamily": "universalSans, Inter, system-ui, sans-serif",
        "fontSize": "20px",
        "fontWeight": 400,
        "lineHeight": "28px",
        "letterSpacing": "0"
      },
      "$type": "typography",
      "$description": "Typography style for display xs."
    },
    "body-lg": {
      "$value": {
        "fontFamily": "universalSans, Inter, system-ui, sans-serif",
        "fontSize": "18px",
        "fontWeight": 400,
        "lineHeight": "28px",
        "letterSpacing": "0"
      },
      "$type": "typography",
      "$description": "Typography style for body lg."
    },
    "body-md": {
      "$value": {
        "fontFamily": "universalSans, Inter, system-ui, sans-serif",
        "fontSize": "16px",
        "fontWeight": 400,
        "lineHeight": "24px",
        "letterSpacing": "0"
      },
      "$type": "typography",
      "$description": "Typography style for body md."
    },
    "body-sm": {
      "$value": {
        "fontFamily": "universalSans, Inter, system-ui, sans-serif",
        "fontSize": "14px",
        "fontWeight": 400,
        "lineHeight": "20px",
        "letterSpacing": "0"
      },
      "$type": "typography",
      "$description": "Typography style for body sm."
    },
    "caption-mono": {
      "$value": {
        "fontFamily": "GeistMono, ui-monospace, SFMono-Regular, Menlo, Monaco, monospace",
        "fontSize": "14px",
        "fontWeight": 400,
        "lineHeight": "20px",
        "letterSpacing": "1.4px"
      },
      "$type": "typography",
      "$description": "Typography style for caption mono."
    },
    "caption-mono-sm": {
      "$value": {
        "fontFamily": "GeistMono, ui-monospace, SFMono-Regular, Menlo, monospace",
        "fontSize": "12px",
        "fontWeight": 400,
        "lineHeight": "16px",
        "letterSpacing": "1.2px"
      },
      "$type": "typography",
      "$description": "Typography style for caption mono sm."
    },
    "button-md": {
      "$value": {
        "fontFamily": "universalSans, Inter, system-ui, sans-serif",
        "fontSize": "14px",
        "fontWeight": 400,
        "lineHeight": "20px",
        "letterSpacing": "0"
      },
      "$type": "typography",
      "$description": "Typography style for button md."
    }
  },
  "spacing": {
    "xxs": {
      "$value": "2px",
      "$type": "dimension",
      "$description": "Spacing step xxs."
    },
    "xs": {
      "$value": "4px",
      "$type": "dimension",
      "$description": "Spacing step xs."
    },
    "sm": {
      "$value": "8px",
      "$type": "dimension",
      "$description": "Spacing step sm."
    },
    "md": {
      "$value": "12px",
      "$type": "dimension",
      "$description": "Spacing step md."
    },
    "lg": {
      "$value": "16px",
      "$type": "dimension",
      "$description": "Spacing step lg."
    },
    "xl": {
      "$value": "24px",
      "$type": "dimension",
      "$description": "Spacing step xl."
    },
    "2xl": {
      "$value": "32px",
      "$type": "dimension",
      "$description": "Spacing step 2xl."
    },
    "3xl": {
      "$value": "48px",
      "$type": "dimension",
      "$description": "Spacing step 3xl."
    },
    "4xl": {
      "$value": "64px",
      "$type": "dimension",
      "$description": "Spacing step 4xl."
    }
  },
  "radius": {
    "none": {
      "$value": "0px",
      "$type": "dimension",
      "$description": "Border radius none."
    },
    "sm": {
      "$value": "8px",
      "$type": "dimension",
      "$description": "Border radius sm."
    },
    "pill": {
      "$value": "9999px",
      "$type": "dimension",
      "$description": "Border radius pill."
    },
    "full": {
      "$value": "9999px",
      "$type": "dimension",
      "$description": "Border radius full."
    }
  },
  "shadow": {},
  "$extensions": {
    "com.design-md-editor.source": {
      "url": "https://x.ai/",
      "note": "Official brand website used for visual comparison."
    }
  }
}
