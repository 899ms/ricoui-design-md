# Optional V13 public-Beta cloud configuration.
# Leave both values unset to keep the app in local-only mode.
# Use the Project URL and the public publishable key (or legacy anon key) only.
# Never put a secret/service_role key in a NEXT_PUBLIC_* variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-public-key

# Required on the server for releases and complete account deletion.
# Prefer the new Supabase secret key. The legacy service-role key is a fallback.
SUPABASE_SECRET_KEY=sb_secret_your-server-only-key
# SUPABASE_SERVICE_ROLE_KEY=your-legacy-service-role-key

# Required before enabling CAPTCHA in Supabase Auth.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-cloudflare-turnstile-site-key

# Optional global AI switch. AI is enabled by default; uncomment to disable it.
# NEXT_PUBLIC_AI_ENABLED=false

# Optional comma-separated exact hostnames allowed through the server AI proxy.
# Do not include protocols, paths, ports, or wildcards.
# AI_PROXY_ALLOWED_HOSTS=api.deepseek.com,api.anthropic.com,open.bigmodel.cn

# Optional GA4 website analytics. This is a public Measurement ID, usually G-... .
# Leave it unset to avoid loading any Google Analytics scripts.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
